/* Codon: intentionally conservative pilot limits; raise only after operator review.
 * Inspired by quantms conf/pride_codon_slurm.config, not copied wholesale.
 * Nextflow orchestrator must run on an allowed login/interactive node; tasks on Slurm.
 */
// Delete the shared work/ dir after a SUCCESSFUL run. Every kept artefact (mzQC,
// receipts, audit) is published with mode 'copy', never a symlink into work/.
// Flight9: work/ held a second copy of every output (~2.8 MB/run); 2 M runs would
// need ~5.6 TB on a 97%-full GPFS. RAW never reaches work/ (scratch true + rmtree).
// A failed run keeps work/ for diagnosis; resume across runs is not used.
cleanup = true
process {
    executor = 'slurm'
    queue = System.getenv('PRIDEQC_SLURM_PARTITION') ?: null
    withName: PRIDEQC_SOURCE_QC {
        // Real active lane: download + QC in node-local Slurm scratch.
        // Bound network transfers and avoid saturating shared Lustre/GPFS.
        maxForks = 2
        maxRetries = 1
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
        cpus = 2
        // Size tier from plan_manifest.py (16/32/64/128 GB); doubled on an OOM/kill retry.
        memory = { "${Math.min((memory_gb as Integer) * (1 << (task.attempt - 1)), 128)} GB" }
        time = { "${4 * task.attempt}h" }
    }
    withName: PRIDEQC_FINALIZE {
        // Bookkeeping only (median 0.2 s in Flight8). Run on the controller node so
        // per-accession finalizers do not use the Slurm submit budget (Flight8: 298
        // finalizer jobs halved the SOURCE_QC submit rate). Container still applies.
        executor = 'local'
        maxForks = 4
        cpus = 1
        memory = '2 GB'
    }
}
executor {
    queueSize = 4
    submitRateLimit = '1/2sec'
}
singularity {
    enabled = true
    autoMounts = true
}
