/* Codon: intentionally conservative pilot limits; raise only after operator review.
 * Inspired by quantms conf/pride_codon_slurm.config, not copied wholesale.
 * Nextflow orchestrator must run on an allowed login/interactive node; tasks on Slurm.
 */
process {
    executor = 'slurm'
    queue = System.getenv('PRIDEQC_SLURM_PARTITION') ?: null
    withName: PRIDEQC_SOURCE_QC {
        // Real active lane: download + QC in node-local Slurm scratch.
        // Bound network transfers and avoid saturating shared Lustre/GPFS.
        maxForks = 2
        maxRetries = 1
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
        cpus = 2
        memory = '32 GB'
        time = '8h'
    }
    withName: PRIDEQC_FINALIZE {
        maxForks = 4
    }
    withName: PRIDEQC_PREPARE {
        maxForks = 2 // Conservative FIRE/network and cluster scratch load
        maxRetries = 1
    }
    withName: PRIDEQC_ANALYZE {
        maxForks = 8
        maxRetries = 2
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
        memory = { 32.GB * task.attempt }
        time = { 8.h * task.attempt }
    }
}
executor {
    queueSize = 4
    submitRateLimit = '1/2sec'
}
singularity {
    enabled = true
    autoMounts = true
}
