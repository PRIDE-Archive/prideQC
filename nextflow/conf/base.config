process {
    withLabel: process_low {
        cpus = 1
        memory = '4 GB'
        time = '1h'
    }
    withLabel: process_medium {
        cpus = 2
        memory = '32 GB'
        time = '8h'
    }
    withName: PRIDEQC_ANALYZE {
        maxForks = 4 // Prevent unrestricted archive downloads and filesystem load
        scratch = true
    }
}
