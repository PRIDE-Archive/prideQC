manifest {
    name = 'PRIDE-Archive/prideQC'
    description = 'Accession-scoped, ID-free PRIDE archive QC; Nextflow DSL2'
    version = '0.1.0-dev'
    nextflowVersion = '>=24.10.0'
}
params {
    input = null
    report_manifest = null
    accession = null    // One PXD for a pilot, null to process all accessions in manifests
    outdir = null
    sif = null
    protocol = 'ftp'   // Explicit --protocol fire on EBI Codon; never silently selected
    checksum_check = true
    estimate_mass_error = false
    estimate_mass_shifts = false
    // Optional exploratory TMT evidence; explicit opt-in, including in pilots.
    tmt_reporter_evidence = false
    tmt_profile_reporter_evidence = false
    // Pilot defaults to a subset, never a verified complete PRIDE study.
    // Safety locked: current workflow refuses true until an independently
    // validated full-inventory attestation check is implemented.
    allow_complete_study = false
}
includeConfig 'conf/base.config'
profiles {
    codon_slurm { includeConfig 'conf/codon_slurm.config' }
    local { process.executor = 'local' }
}
process {
    shell = ['/bin/bash','-euo','pipefail']
    errorStrategy = 'terminate'
}
singularity {
    enabled = true
    autoMounts = true
    cacheDir = "${System.getenv('NXF_SINGULARITY_CACHEDIR') ?: '/tmp/prideqc-nextflow-singularity-cache'}"
}
// This is a workflow run by operators, never a live production PRIDE data deployment.
timeline { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/timeline.html" }
report   { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/execution-report.html" }
trace    { enabled = true; file = "${params.outdir ?: 'results'}/pipeline_info/trace.tsv" }
